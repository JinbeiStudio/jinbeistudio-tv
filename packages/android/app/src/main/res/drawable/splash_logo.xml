<?xml version="1.0" encoding="utf-8"?>
<!-- On Android 12's 288 dp splash icon canvas, Jinbei Studio's logo as the web app's index.html draws it; inside the 192 dp circle Android keeps. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="160dp"
        android:height="163dp"
        android:drawable="@drawable/splash_jinbei"
        android:gravity="center" />
</layer-list>
